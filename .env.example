# Copy to .env.local for local development. Everything here is optional.

# --- Site (public, inlined into the static build) -------------------------

# URL of the deployed AI worker (see ai-worker/README.md). Must be an absolute
# http(s) URL; when unset, all AI features are hidden.
NEXT_PUBLIC_AI_ENDPOINT=

# Cloudflare Turnstile site key (public). The secret lives in the worker.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Web3Forms access key for the contact form (https://web3forms.com).
# Without it, the form opens the visitor's email app instead.
NEXT_PUBLIC_WEB3FORMS_KEY=

# GoatCounter site code, e.g. "omar" for https://omar.goatcounter.com.
# Analytics load only in production builds and only when this is set.
NEXT_PUBLIC_GOATCOUNTER_CODE=

# --- Local scripts only (never shipped) ------------------------------------
# Used by `pnpm ai:summaries` and `pnpm career`.
AI_PROVIDER=gemini
AI_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
