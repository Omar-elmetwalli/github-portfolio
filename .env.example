# Copy to .env.local for local development. All of these are optional.

# Web3Forms access key for the contact form (https://web3forms.com).
# Without it, the form opens the visitor's email app instead.
NEXT_PUBLIC_WEB3FORMS_KEY=

# GoatCounter site code, e.g. "omar" for https://omar.goatcounter.com.
# Analytics load only in production builds and only when this is set.
NEXT_PUBLIC_GOATCOUNTER_CODE=
