{
  "name": "omar-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/fix-export-segments.mjs",
    "start": "node scripts/serve-export.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "optimize:images": "node scripts/optimize-images.mjs",
    "preview": "node scripts/serve-export.mjs",
    "ai:summaries": "node scripts/generate-summaries.ts",
    "career": "node scripts/career-tools.ts",
    "worker:test": "pnpm --dir ai-worker test",
    "check:links": "node scripts/check-links.mjs",
    "test:e2e": "playwright test",
    "test:e2e:build": "cross-env NEXT_PUBLIC_AI_ENDPOINT=https://ai.mock.test pnpm build",
    "admin": "node scripts/admin/server.mjs"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "next": "16.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^20.19.30",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18"
  }
